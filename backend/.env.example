# Copy this file to .env and fill in real values.
# .env itself is gitignored — never commit real credentials.

APP_ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=email_intelligence

LOG_LEVEL=INFO
LOG_JSON=false

# Phase 17 (real authentication) -- signs/verifies every JWT
# app/core/security.py issues. Was a placeholder before Phase 17; now a
# real credential. Generate a real one before any non-local use:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Since Phase 22, JWTs are RS256-signed (PRD SS6.4) and SECRET_KEY is only
# used if JWT_ALGORITHM=HS256 is set explicitly.
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# Phase 22 -- RS256 keypair, PEM with newlines written as a literal "\n".
# Required when APP_ENV=production. Left empty locally: a keypair is
# generated once into JWT_KEY_DIR and reused across restarts.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   openssl pkey -in jwt.pem -pubout -out jwt.pub
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_DIR=.jwt_keys

# Phase 22 -- per-organization API rate limit (PRD SS13.1).
RATE_LIMIT_PER_MINUTE=1000

# Phase 10 (Auto-Reply Generation) — Groq (https://console.groq.com/keys).
# Never commit a real key. GROQ_API_KEY is required; the numbered ones are
# optional extra keys the provider rotates to on a 429 (rate-limit) response
# — see docs/architecture_auto_reply.md for why one key is normally enough
# (Groq's rate limits are per-organization, not per-key, so extra keys from
# the SAME account do not multiply your throughput; they're only useful as
# genuinely separate accounts/credentials).
GROQ_API_KEY=CHANGE_ME
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_MODEL=llama-3.3-70b-versatile

# Post-Phase-10 fix #5 — Ollama local fallback, used only when Groq
# returns a 429 (rate-limited) or 503 (service unavailable). No API key
# needed; requires a locally-running Ollama server with this model pulled
# (`ollama pull mistral:7b`) for the fallback to actually succeed.
OLLAMA_MODEL=mistral:7b
OLLAMA_BASE_URL=http://localhost:11434

# Phase 18 (live mailbox ingestion) — must match docker-compose.yml's api
# port mapping (8001 on the host). Used to build each provider's
# redirect_uri; Google/Microsoft reject an OAuth callback whose
# redirect_uri doesn't exactly match what's registered with them.
APP_BASE_URL=http://localhost:8001

# Google Cloud Console (console.cloud.google.com) -> APIs & Services ->
# Credentials -> Create OAuth client ID (type "Web application") -> add
# redirect URI: {APP_BASE_URL}/api/v1/mailbox/gmail/callback. Enable the
# Gmail API for the project and add the gmail.readonly scope on the OAuth
# consent screen. Leave blank to disable Gmail connections entirely
# (connect_mailbox returns 503, nothing else breaks).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure Portal (portal.azure.com) -> App registrations -> New
# registration -> add redirect URI (platform "Web"):
# {APP_BASE_URL}/api/v1/mailbox/outlook/callback. Grant the Microsoft
# Graph DELEGATED permissions Mail.Read and offline_access. Leave blank to
# disable Outlook connections entirely.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Encrypts stored Gmail/Outlook refresh tokens at rest
# (app/core/token_encryption.py) -- separate secret from SECRET_KEY above
# (different trust boundary: this one only decrypts stored mailbox
# credentials, it can't forge a login session). Generate a real one
# before any non-local use, same command as SECRET_KEY.
MAILBOX_TOKEN_ENCRYPTION_KEY=CHANGE_ME_IN_PRODUCTION
